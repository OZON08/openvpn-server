# Copy to .env and set your own values. Do not commit .env.
OPENVPN_ADMIN_USERNAME=admin
OPENVPN_ADMIN_PASSWORD=change-me

# Group with access to the management socket. It must not belong to any host user.
# OPENVPN_MI_GID=61194

# Shared secret of the client-disconnect hook, see docker-compose.yml.
# Create one with: openssl rand -hex 32
# OPENVPN_UI_HOOK_TOKEN=
